{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "outDir": "out/tsc-web"
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/api.d.ts",
    "src/shared/**/*"
  ],
  "exclude": [
    "src/shared/**/*.test.ts"
  ]
}
